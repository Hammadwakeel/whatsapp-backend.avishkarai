# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inika_db

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# LLM (Shared across all tenants)
WIKI_PATH=wiki
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=anthropic/claude-3-haiku

# Web Search (Shared across all tenants)
TAVILY_API_KEY=tvly-...

# Baileys Gateway - Local Node.js WhatsApp gateway
# Install: cd scripts/whatsapp-gateway && npm install && npm start
BAILEYS_GATEWAY_URL=http://localhost:3002
BAILEYS_GATEWAY_API_KEY=

# API base URL (for building webhook URLs the gateway can reach)
# For local Docker: http://host.docker.internal:8000
# For production: https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

# Inika External Booking API
INIKA_API_KEY=your-inika-api-key
INIKA_BOOKING_KEY=your-inika-booking-key

# OpenWeatherMap API
OPENWEATHER_API_KEY=your-openweather-api-key

# Webhook tenant routing (UUID) - empty = first tenant for single-hotel setups
WEBHOOK_WHATSAPP_TENANT_ID=
