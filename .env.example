# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inika_db

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# LLM (Shared across all tenants)
WIKI_PATH=wiki
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=anthropic/claude-3-haiku

# Web Search (Shared across all tenants)
TAVILY_API_KEY=tvly-...

# =============================================================================
# WhatsApp Gateway Options
# =============================================================================
# Choose ONE of these options:
#   1. Baileys Gateway (local Node.js - recommended for development)
#   2. WAHA (Docker container - production ready)
#   3. Evolution API (deprecated, Docker container)

# Option 1: Baileys Gateway (Node.js)
# Install: cd scripts/whatsapp-gateway && npm install && npm start
BAILEYS_GATEWAY_URL=http://localhost:3002
BAILEYS_GATEWAY_API_KEY=

# Option 2: WAHA (Docker) - production ready
# Start: docker compose -f docker-compose.waha.yml up -d
WAHA_URL=http://localhost:3001
WAHA_API_KEY=

# Option 3: Evolution API (deprecated)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=inika

# Docker compose only: WhatsApp Web client version from web.whatsapp.com → Menu → Help (fixes empty QR / count=0)
# CONFIG_SESSION_PHONE_VERSION=2.3000.1037554587

# Which tenant receives Evolution webhooks when multiple hotels share one backend (UUID)
# WEBHOOK_WHATSAPP_TENANT_ID=

# Docker Evolution → Inika webhook URL (when API is not the docker `api` service)
# WEBHOOK_GLOBAL_URL=http://host.docker.internal:8000/webhook/whatsapp?tenant_id=<paste-tenant-uuid>

# Docker compose only: host port for the `api` service if port 8000 is already in use (e.g. local uvicorn).
# API_HOST_PORT=8001

# Inika External Booking API
INIKA_API_KEY=your-inika-api-key
INIKA_BOOKING_KEY=your-inika-booking-key

# OpenWeatherMap API
OPENWEATHER_API_KEY=your-openweather-api-key

# =============================================================================
# IMPORTANT: WhatsApp Webhook Configuration
# =============================================================================
# Evolution API sends webhooks here when WhatsApp messages are received.
# For local development with Docker, use: http://host.docker.internal:8000
# For production, use your public domain: https://api.yourdomain.com
# The webhook URL must be accessible from the Evolution API container.
#
# Example for local Docker setup:
# API_BASE_URL=http://host.docker.internal:8000
#
# Example for production:
# API_BASE_URL=https://api.yourdomain.com
# EVOLUTION_WEBHOOK_URL=https://api.yourdomain.com
API_BASE_URL=http://host.docker.internal:8000
# EVOLUTION_WEBHOOK_URL=